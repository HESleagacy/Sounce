# Required: only this WhatsApp self-chat is accepted. Include the country code,
# without a leading + sign. Example for an Indian number: 919876543210.
OWNER_JID=919876543210@s.whatsapp.net

# IANA timezone used for the owner's conversational context.
OWNER_TIMEZONE=Asia/Kolkata

# Required outside --self-chat-check mode. Never commit the real key.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# Persistent application and WhatsApp session state.
DATABASE_URL=sqlite:///data/sounce.db
NEONIZE_SESSION_PATH=data/neonize.db

# Message processing. The in-memory queue is only a latency optimisation; every
# accepted message is committed to the durable inbox first, so overflow is
# back-pressure rather than data loss.
MESSAGE_QUEUE_SIZE=100
MESSAGE_LEASE_SECONDS=300
MESSAGE_MAX_ATTEMPTS=3
MESSAGE_BACKOFF_SECONDS=10
PENDING_ACTION_TTL_MINUTES=30
LOG_LEVEL=INFO

# Reminder delivery. The lease is how long before a reminder left mid-delivery by
# a crashed process is reclaimed and retried.
REMINDER_POLL_SECONDS=10
REMINDER_LEASE_SECONDS=120
REMINDER_MAX_ATTEMPTS=5
WHATSAPP_RECONNECT_INITIAL_SECONDS=5
WHATSAPP_RECONNECT_MAX_SECONDS=60
MEDIA_DIR=data/media
MAX_MEDIA_BYTES=20971520

# Required for full V1 acceptance: Maya text-to-speech. Text remains the failure fallback.
MAYA_API_URL=https://tts.mayaresearch.ai/v1/tts
MAYA_API_KEY=
MAYA_VOICE=Ananya
MAYA_MODEL=Maya 2 Native

# Required for full V1 acceptance: Google Calendar sync for confirmed reminders and events.
# Requires an OAuth client and refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_TOKEN_PATH=data/google_calendar_token.json
GOOGLE_OAUTH_REDIRECT_PORT=8765

# Calendar outbox. Ops are written in the same transaction as the local change
# and drained here with exponential backoff, so an outage cannot desynchronise
# local state from the remote calendar.
CALENDAR_POLL_SECONDS=15
CALENDAR_MAX_ATTEMPTS=6
CALENDAR_BACKOFF_SECONDS=30

# Data lifecycle. Retention expires raw messages, transcripts, media and settled
# jobs. Memories, reminders, preferences and timeline events are kept until you
# erase them, and any message cited as provenance is never expired.
# Set to 0 to keep raw material indefinitely.
RETENTION_DAYS=365
RETENTION_INTERVAL_HOURS=24
EXPORT_DIR=data/exports

# Readiness: durable backlog size at which /ready starts failing.
HEALTH_BACKLOG_THRESHOLD=500

# HTTP health listener for container orchestration. Serves /live (restart on
# failure) and /ready (take out of rotation on failure). Unset to disable.
PORT=8080
